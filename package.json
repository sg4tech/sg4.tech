{
  "name": "sg4tech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": "^11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-og.mjs && node scripts/postbuild-inline-spacing.mjs && node scripts/postbuild-font-preloads.mjs",
    "start": "next start",
    "preview": "npm run build && serve out -l 3001",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint app tests scripts/security-audit.ts --ext .ts,.tsx --max-warnings=0",
    "lint:css": "stylelint \"app/**/*.css\"",
    "lighthouse": "lhci autorun",
    "security:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security-audit.ts",
    "security:code": "eslint app tests --ext .ts,.tsx --config eslint.security.config.mjs --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --passWithNoTests=false",
    "knip": "knip",
    "optimize:svg": "svgo --multipass public/brand/logo.svg",
    "depcruise": "depcruise --config .dependency-cruiser.cjs app",
    "jscpd": "jscpd",
    "check": "npm run lint && npm run security:audit && npm run security:code && npm run typecheck && npm run test && npm run knip && npm run depcruise && npm run jscpd && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@next/eslint-plugin-next": "^16.4.5",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-x": "^5.28.8",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "compression": "^1.8.2",
    "basic-ftp": "^6.2.2",
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    }
  }
}
